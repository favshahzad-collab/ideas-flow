[Unit]
Description=Run the DAWS backup nightly

[Timer]
# Two in the morning, local time. Not on the hour: every cron job anybody has
# ever written runs at the top of one, and a backup competing with all of them
# for the same disk takes longer than it needs to.
OnCalendar=*-*-* 02:17:00

# If the machine was off at 02:17, run it when it comes back rather than
# skipping the night. A missed backup is the one you find out about later.
Persistent=true

# Spread across five minutes, so a fleet of these does not start together.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
