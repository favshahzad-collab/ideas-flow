  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.20.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
