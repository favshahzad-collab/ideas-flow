  "scripts": {
    "test": "vitest run",
    "test:db": "vitest run --config vitest.config.integration.mts",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:workflows": "tsx scripts/seed-workflow-templates.ts",
    "check:fresh-install": "tsx scripts/fresh-install-check.ts",
    "check:env": "tsx scripts/check-env.ts",
