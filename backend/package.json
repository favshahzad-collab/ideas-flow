  "//overrides": [
    "npm audit reports six advisories here, and every fix it offers is a",
    "DOWNGRADE: `npm audit fix --force` installs prisma 6.19.3 and exceljs",
    "3.4.0. Losing a major version of the ORM to silence a transitive advisory",
    "is the wrong trade, so each one is pulled FORWARD to the first patched",
    "release instead.",
    "uuid: exceljs 4.4.0 asks for ^8.3.0 and uses only v4(); the bounds-check",
    "flaw is in v3/v5/v6 when a buffer is passed, which exceljs does not do.",
    "Raised anyway because it is cheap and the spreadsheet tests cover it.",
    "deepmerge-ts: @prisma/config pins 7.1.5 exactly, so this override is the",
    "one to look at first if the Prisma CLI ever misreads prisma.config.ts.",
    "mysql2: a hard dependency of the prisma CLI that this application never",
    "loads - the datasource is Postgres. Raised to keep `npm audit` meaningful",
    "rather than a list everybody learns to scroll past."
  ],
  "overrides": {
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.4"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^18.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  }
}
