# Database (PostgreSQL 14+)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Secret used to sign access/refresh tokens.
# Required in production, must be 32+ characters:  openssl rand -base64 48
JWT_SECRET="change-me"

# Directory for uploaded documents and signatures
STORAGE_DIR="./storage"

# Server
PORT=3000
NODE_ENV=development
# The address the API listens on. Unset is every interface. 127.0.0.1 keeps it
# off the network when the web server on the same machine is the only thing
# that talks to it - which is also what makes TRUST_PROXY=1 safe, since then
# nobody can reach the API directly to hand it a made-up X-Forwarded-For.
# HOST=127.0.0.1

# How much the API says about itself: debug, info, warn, error, silent.
#
# Unset means `info`, except under test where it means `silent` - several
# hundred integration tests drive the real app, and at `info` the output that
# matters is buried in the middle of theirs.
#
# One JSON object per line on stdout, which every log shipper reads and which
# needs no agent, no collector and no network. Point systemd, Docker or your
# platform at stdout and keep them.
#
# Every request produces one `http` line carrying a request id, the method,
# the route pattern, the status, the duration and the actor's id. That id is
# also returned to the caller as `X-Request-Id` and, on a 500, in the response
# body - so "it failed and it said 6f8ee119" is a search rather than an
# investigation.
#
# Identifiers only, never content. A document id but never its title, an actor
# id but never their email, the fact of a search but never what was searched
# for. Log files are copied to laptops and support tickets; the memos here are
# increments, warnings and terminations. `redact()` in src/lib/logger.ts
# enforces what can be enforced.
LOG_LEVEL=

# Email. Optional, and there are now two ways to set it.
#
# The one to reach for first is NOT this file: Administration -> Mail, in the
# application, holds all of it and takes effect without a restart. What is here
# is the fallback - it applies when nothing has been saved on that screen, and
# is the right place for a deployment that manages configuration as files.
#
# With neither set the application runs exactly as before: notices are queued
# and visible in the app, nothing is delivered, and the API says so once at
# startup.

# --- Microsoft Graph (recommended on Microsoft 365) ---------------------
#
# App-only, client credentials: the backend authenticates as itself, there is
# no user sign-in and no callback URL, so localhost never needs to be publicly
# reachable. The app registration needs the Mail.Send APPLICATION permission
# with admin consent granted.
#
# Preferred over SMTP because the message goes to Exchange Online through the
# API rather than being relayed in, so SPF is not in the way - and an SPF
# record that is wrong fails silently, with notices landing in Junk.
#
# WARNING: Mail.Send as an application permission is tenant-wide. The token can
# send as any mailbox in the directory, and GRAPH_MAILBOX below does not change
# that - it only keeps this application honest. Scope the app registration with
# an Exchange ApplicationAccessPolicy to bind it to one mailbox.
#
# Never put any of this in a VITE_ variable: those reach the browser.
MAIL_PROVIDER=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
GRAPH_MAILBOX=
GRAPH_SAVE_TO_SENT_ITEMS=true
#
#   MAIL_PROVIDER=microsoft-graph
#   MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
#   MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
#   MICROSOFT_CLIENT_SECRET=the-secret-VALUE-not-its-id
#   MAIL_FROM_ADDRESS=noreply@example.com
#   MAIL_FROM_NAME=Ideas Flow
#   GRAPH_MAILBOX=noreply@example.com

# --- SMTP (any other mail server) ---------------------------------------
#
# Set SMTP_HOST and MAIL_FROM together to turn delivery on; the rest have
# defaults. SMTP_SECURE is implicit TLS: leave it false for 25 and 587, which
# start in the clear and upgrade with STARTTLS. Setting it true on 587 is what
# produces "ssl3_get_record:wrong version number".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ideas Flow <no-reply@example.com>"

# Worked example - Microsoft 365, Direct Send. Every approver is a colleague,
# so the simplest method Microsoft offers fits: no mailbox, no licence, no
# credentials, no connector. Find your own host in your MX record:
#
#   nslookup -type=mx example.com
#   -> example-com.mail.protection.outlook.com
#
#   SMTP_HOST=example-com.mail.protection.outlook.com
#   SMTP_PORT=25          # not 587: port 25 starts clear and upgrades with STARTTLS
#   SMTP_SECURE=false
#   SMTP_USER=            # both left unset
#   SMTP_PASSWORD=
#   MAIL_FROM="Ideas Flow <no-reply@example.com>"
#
# Two things decide whether this works, and neither is in this file:
#
#   1. SPF. Add the sending server to the domain's record - as an `ip4:` term,
#      which costs none of SPF's ten-lookup budget. Without it nothing bounces;
#      approval notices land in Junk, nobody sees them, and the memos just sit.
#      That looks exactly like an application which is not sending mail.
#   2. Direct Send may be switched off for the tenant. Ask whoever runs it for
#      `Get-OrganizationConfig | fl RejectDirectSend`. If it is True, use SMTP
#      relay with an inbound connector instead.
#
# Direct Send reaches your own domains only. Route a memo to a contractor on an
# outside address and it will not arrive. See DEPLOY.md for the relay setup.
#
# Then prove it rather than assuming: Administration -> Send a test delivers to
# your own address from the running application and reports the failure
# verbatim if it does not.

# Where the links in those emails point. Without it they point at the dev UI,
# which is no use to anybody reading their mail on a phone. Use the https://
# address people actually type, and the same origin that serves the UI.
# Required when NODE_ENV=production, here or on Administration -> Mail.
APP_URL=https://flow.example.com

# The time zone the signature certificate on every approved memo shows times
# in (UTC is printed beside each one). An IANA name such as Asia/Karachi;
# a typo is refused at start-up. Default Asia/Karachi.
TIME_ZONE=Asia/Karachi

# The organisation's digital seal on every approved memo (see DEPLOY.md).
# The .p12 holds the certificate AND its private key: keep it on the server,
# readable only by the service account. Make a self-made one with
#   SEAL_P12_PASSWORD='<passphrase>' npm run seal:create-certificate -- <folder>
# or point these at one bought from a trusted authority. Unset: approved memos
# are not sealed, and the API says so once at start-up.
SEAL_P12_PATH=
SEAL_P12_PASSWORD=
# What the seal says as its location. Default "Ideas Flow".
SEAL_LOCATION=
# Whether approved memos are sealed when a certificate is configured. Normally
# switched on Administration -> Workflow policy, which wins once saved; this is
# the answer until then. Only "false" turns it off. Default true.
SEAL_APPROVED_MEMOS=

# How often the outbox is swept. Minimum 5, default 60.
MAIL_SWEEP_SECONDS=

# How many working days an approval step is given, when it names none itself.
#
# Unset means no deadline at all, which is the delivered behaviour: the queue
# shows how long a memo has been waiting, which is true, rather than a
# countdown to a date nobody agreed to. Set it to a whole number of days and
# every step gets it unless the chain or the workflow template says otherwise.
#
# Counted in working days from the day after the memo reaches the approver,
# ending at the end of that day. Weekends are skipped; public holidays are not
# known to this application, so give the step more days rather than expecting
# it to know about them.
SLA_DEFAULT_DAYS=

# How often to look for steps that have run past their deadline, in minutes.
# Unset means 15. Nothing is sent unless a deadline exists, and each step is
# chased once - the approver holding it and the person who prepared it.
SLA_SWEEP_MINUTES=

# How many proxies stand in front of this API.
#
# Unset means none, and means the API believes only the socket - which is
# right when it is exposed directly, and wrong the moment anything forwards to
# it. Behind the nginx in DEPLOY.md, set this to 1. Without it, `req.ip` is the
# proxy's address, so every approval's audit row records the proxy rather than
# the approver, and the per-address sign-in cap counts the whole organisation
# as one device - forty failed attempts by anybody locks out everybody.
#
# A count, not `true`: `true` believes the left-most X-Forwarded-For entry,
# which any client can write. A count makes Express walk in from the socket
# and stop at the address the proxy itself appended.
#
# Required when NODE_ENV=production: the API will not start without it. Set
# false if nothing stands in front of the API - that is a decision too.
TRUST_PROXY=

# How often the audit trail is sealed, in seconds.
#
# Each audit record is given a digest over its own contents and the digest of
# the record before it, which is what makes an edited or deleted record
# detectable. It happens in a sweep rather than in the transaction that wrote
# the record: chaining must be serialised, and an approval must not wait behind
# somebody else's audit write to commit. Unset means 30; the minimum is 5. This
# interval is the window in which a record could be removed leaving nothing
# behind, so shorter is safer - and each sweep takes a lock every other sealer
# waits on, so it is not free either.
LEDGER_SEAL_SECONDS=

# May the preparer pass over an approver who has not acted yet?
#
# Unset means no, which is the delivered behaviour: a memo carries the
# approvals it says it carries, and the one bypass in the product was in the
# hands of the person who most wants the memo through. Setting it to `true`
# turns the endpoint back on - it still demands a written reason, still writes
# an audit row and a comment naming who was passed over, and still refuses to
# touch the final approver - and it is a decision an organisation owns
# explicitly.
#
# Nothing has to be set in the frontend to match. The button follows the
# server's answer, which the client reads from GET /api/auth/me, so the two
# cannot disagree. (There was a build-time flag for this and it was removed
# for exactly that reason - see `frontend/src/config/features.ts`.)
#
# This is the fallback. Administration -> Workflow policy stores a row that
# wins over this variable entirely, and takes effect without a restart.
ALLOW_STEP_SKIP=

# Administrators must have two-step sign-in. Leave unset: an administrator
# without it can sign in but sees only the setup screen, and every other
# request is refused until it is done. Only the word "false" turns this off,
# which is for test and CI environments that drive the app as a seeded
# administrator - see DEPLOY.md, "Two-step sign-in".
REQUIRE_ADMIN_TWO_FACTOR=

# Virus scanning of uploads, through a clamd your organisation runs. Unset
# means nothing is scanned (the file-type checks still run). Once CLAMAV_HOST
# is set the scanner is REQUIRED: if it is down, slow or answers oddly, the
# upload is refused with a 503 rather than let through. See DEPLOY.md,
# "Uploaded files are read, not just labelled".
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Sessions are recorded and revocable.
#
# There is nothing to configure - it is listed here so an operator knows the
# table exists. Every sign-in writes a row to refresh_sessions holding the
# SHA-256 of the refresh token, never the token; POST /api/auth/sign-out ends
# one session or all of them, and ending all of them also moves a cutoff on
# the account that refuses access tokens already issued. Changing somebody's
# password or role ends their sessions too, which is most of the point of
# being able to change either.

# The first administrator, created by `npm run seed`.
#
# The seed is safe to re-run - it upserts - and refuses to run in production
# without a password, so this is the one that must be set on a real server.
# The email defaults to admin@example.com, which is fine for a demo and is not
# fine for anything else: an account nobody can receive mail at cannot be
# recovered.
#
# The NAME matters as much as the address. First and last name are printed
# under this person's signature on every memo they sign and the designation
# beneath that, so a server seeded with only the email above ends up with a
# real address attached to somebody called "Admin User" - in the ledger, for
# good. Set all four on a real deployment:
#
#   SEED_ADMIN_EMAIL=firstname.lastname@example.com
#   SEED_ADMIN_PASSWORD=<strong, and changed after the first sign-in>
#   SEED_ADMIN_FIRST_NAME=Firstname
#   SEED_ADMIN_LAST_NAME=Lastname
#   SEED_ADMIN_DESIGNATION=Head of Human Resources
#
# Re-running the seed updates the password and the designation but NOT the
# name: it must not rewrite who signed the memos already in the ledger.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_DESIGNATION=

# The password given to every invented person in `npm run seed:demo`.
#
# That seed refuses to run against a production database at all, so this
# exists for review environments. Unset means a default nobody should rely on.
SEED_DEMO_PASSWORD=

# `npm run check:env` checks this file the way the API does at startup,
# without starting it. Run it on a server before deploying a new version.

# Where `npm run test:db` runs. The integration suite TRUNCATES every table
# between tests, so it never falls back to DATABASE_URL: it has no default,
# and refuses any url whose database name does not end in `_test` or that
# matches DATABASE_URL. Create it once with:
#
#   createdb daws_test          (or: docker exec <container> \
#                                     psql -U daws -d postgres \
#                                     -c "CREATE DATABASE daws_test")
#
# Migrations are applied automatically at the start of every run.
TEST_DATABASE_URL="postgresql://daws:daws@localhost:5432/daws_test"
